# Copy to .env and set real values. Server-only (not in Vite define).

# Optional local-only automatic admin access. Ignored in production.
# DEV_AUTH_BYPASS=false

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Session encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<32-byte random hex>

# App URL — use https://your-domain.com in production (for OAuth callback)
APP_URL=http://localhost:3000

# Supabase Postgres — the ONLY database. Stores all app data + login sessions + TTS cache.
# Get this from: Supabase Dashboard → Project → Connect → "Session pooler".
#
# IMPORTANT for Docker: use the SESSION POOLER host below (IPv4-compatible, port 5432).
# Do NOT use the direct "db.<ref>.supabase.co" host — it is IPv6-only and fails inside
# containers with ENETUNREACH/ENOTFOUND. Replace [YOUR-PASSWORD] and [REGION] with real values.
DATABASE_URL=postgresql://postgres.ykaudwlislohrwoephga:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Gemini API (for TTS/quiz). Can be exposed to client for live features.
GEMINI_API_KEY=

# AI Provider for answer evaluation. "gemini" (default) or "local" (Ollama).
# AI_PROVIDER=gemini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b

# ── Reading practice analysis (V2 local pipeline) ──────────────────────
# URL of the local analysis service (whisper + praat + ollama coaching).
# Docker Compose sets this automatically; for `npm run dev` against a
# locally running service use http://localhost:8001. Unset = Gemini analyzes
# readings directly (V1 path). In the legacy flow, Gemini is the fallback if the service
# is unreachable. Azure mode requires the local service.
# ANALYSIS_URL=http://localhost:8001

# Whisper model for transcription: tiny/base/small/medium (small = good
# accuracy on accented English, still CPU-friendly).
# WHISPER_MODEL=small

# Coaching-text model served by Ollama (used by the analysis service).
# OLLAMA_MODEL=qwen2.5:7b

# Set to 1 to enable the vocal-confidence model (audEERING wav2vec2).
# Requires `pip install -r analysis/requirements-emotion.txt` (or uncomment
# the line in analysis/Dockerfile). Downloads ~1.5 GB of weights on first use.
# ENABLE_EMOTION=0

# Azure checkpoints + local practice + Gemini text coaching. Leave unset to
# retain the existing analysis flow until Azure and the local service are ready.
# READING_ANALYSIS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_LOCALE=en-IN
# Uses key + region with the Speech SDK. Foundry project/OpenAI endpoints are
# not Speech endpoints; AZURE_SPEECH_ENDPOINT is not needed by this adapter.
# Requires ANALYSIS_URL plus ffmpeg on the Node host (included in Docker).
# Fixed cap: 1800 submitted audio seconds per candidate per UTC calendar month.
# Azure at attempt 1, 6, 11, ... when budget remains; other attempts use local.
